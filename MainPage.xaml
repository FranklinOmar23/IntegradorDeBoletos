<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IntegradorDeBoletos.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IntegradorDeBoletos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock
            Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="Contador de demostración"
            HorizontalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Button
                AutomationProperties.Name="Disminuir contador"
                Command="{x:Bind ViewModel.DecrementCommand}"
                ToolTipService.ToolTip="Disminuir">
                <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
            <TextBlock
                Text="{x:Bind ViewModel.Counter, Mode=OneWay}"
                VerticalAlignment="Center"
                MinWidth="48"
                TextAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button
                AutomationProperties.Name="Aumentar contador"
                Command="{x:Bind ViewModel.IncrementCommand}"
                ToolTipService.ToolTip="Aumentar">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
        </StackPanel>
    </StackPanel>
</Page>
